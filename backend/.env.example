# ──────────────────────────────────────────────
#  Quip Backend — Environment Variables
# ──────────────────────────────────────────────

# News
NEWS_API_KEY=your_newsapi_key_here               # https://newsapi.org (free tier: 100 req/day) — legacy, Quip now uses Finnhub
FINNHUB_API_KEY=your_finnhub_api_key_here        # https://finnhub.io — free tier, no card required

# Market Data (choose one or both)
ALPACA_API_KEY=your_alpaca_api_key_here          # https://alpaca.markets
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600                                   # seconds

# SEC EDGAR (no key needed, just a User-Agent string)
SEC_USER_AGENT=Quip/1.0 contact@yourdomain.com

# Optional: Unusual Whales (options flow)
UNUSUAL_WHALES_API_KEY=

# App
APP_ENV=development                              # development | production
LOG_LEVEL=INFO

# FinBERT model (HuggingFace ID — downloads ~500 MB on first run)
FINBERT_MODEL=ProsusAI/finbert

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Morning Brief — comma-separated watchlist
MORNING_BRIEF_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,JPM,NFLX,AMD

# FinoLens combiner (URL of the FinoLens technical signal service)
FINOLENS_SERVICE_URL=http://localhost:8001

# ── AI Model API Keys ──────────────────────────────────────────────────────────
GROQ_API_KEY=           # free at console.groq.com         — llama-3.3-70b-versatile
GEMINI_API_KEY=         # free at aistudio.google.com/app/apikey — gemini-2.0-flash
ANTHROPIC_API_KEY=      # console.anthropic.com             — claude-haiku-4-5 (~$0.001/1K tokens)
